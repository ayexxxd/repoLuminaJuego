  bancoPreguntas:
  - pregunta: "\xBFQu\xE9 t\xE9cnica consiste en darle ejemplos previos a la IA antes
      de que responda?"
    opciones:
    - Few-Shot Prompting
    - Overfitting
    - Deep Learning
    - Redes Neuronales
    indiceCorrecto: 0
  - pregunta: "\xBFCu\xE1l es el objetivo principal de agregar \"Piensa paso a paso\"
      (Chain of Thought)?"
    opciones:
    - Ahorrar memoria RAM
    - "Forzar el razonamiento l\xF3gico"
    - Traducir a varios idiomas
    - Evitar ataques de hackers
    indiceCorrecto: 1
  - pregunta: "\xBFC\xF3mo se llama al ataque donde el usuario usa el prompt para
      evadir las reglas de la IA?"
    opciones:
    - Phishing Neural
    - Overfitting
    - Token Bleeding
    - Prompt Injection
    indiceCorrecto: 3
  - pregunta: "\xBFQu\xE9 t\xE9cnica (por sus siglas) conecta a la IA con una base
      de datos externa para darle contexto real?"
    opciones:
    - RAG (Retrieval-Augmented)
    - API (Application Interface)
    - NLP (Natural Language)
    - CSS (Cascading Style)
    indiceCorrecto: 0
